@@ -0,0 +1,508 @@
+#include "ClaudeUsageActivity.h"
+
+#include <Arduino.h>
+#include <GfxRenderer.h>
+#include <HalClock.h>
+#include <HalStorage.h>
+#include <I18n.h>
