+#include <algorithm>
+#include <cstdio>
+#include <ctime>
+#include <string>
+
+#include "CrossPointSettings.h"
+#include "MappedInputManager.h"
+#include "NetworkStartup.h"
+#include "activities/apps/GameUi.h"
+#include "activities/network/WifiSelectionActivity.h"
