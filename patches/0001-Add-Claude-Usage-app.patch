+// Usage gauge: a half-dial with a needle over two stacked usage bars.
+constexpr Bitmap claudeUsage() {
+  Bitmap icon;
+  for (int y = -11; y <= 0; ++y) {
+    for (int x = -11; x <= 11; ++x) {
+      const int distance = x * x + y * y;
+      if (distance <= 121 && distance >= 81) icon.ink(16 + x, 15 + y);
+    }
+  }
+  icon.line(5, 15, 27, 15);
+  icon.line(16, 15, 22, 8);
+  icon.line(16, 14, 21, 8);
+  icon.filledRect(15, 14, 3, 3);
+  icon.rect(4, 19, 24, 4);
+  icon.filledRect(5, 20, 15, 2);
+  icon.rect(4, 25, 24, 4);
+  icon.filledRect(5, 26, 8, 2);
+  return icon;
+}
